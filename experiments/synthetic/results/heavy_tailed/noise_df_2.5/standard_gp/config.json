{
  "seed": 2421,
  "mode": "evaluate",
  "algorithm": "standard_gp",
  "num_instances": 10,
  "results_root": "${script_dir:}/results",
  "kernel": {
    "lengthscale": 0.3
  },
  "pro": {
    "step_size": 0.0001,
    "alpha": 1.0,
    "sigma_init": 0.3,
    "sigma_min": 0.1,
    "sigma_max": 1.0,
    "num_particles": 32,
    "num_folds": 1,
    "val_fraction": 0.25,
    "num_adapt_steps": 10000,
    "warmup_steps": 1000,
    "sigma_adapt_steps": 200,
    "kernel_adapt_steps": 100,
    "sigma_lr": 0.1,
    "kernel_lr": 0.01,
    "num_sample_steps": 30000,
    "burn_fraction": 0.9,
    "thin": 10
  },
  "panel": {
    "num_instances": 20,
    "grid_shape": [
      5,
      4
    ]
  },
  "source": "heavy_tailed",
  "param_name": "noise_df",
  "noise_df": 2.5,
  "noise_std_frac": 0.5
}